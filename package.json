{
  "name": "codr",
  "productName": "Codr",
  "author": "Quinn Finney",
  "description": "Desktop chat UI for the Claude Agent SDK with remote web access",
  "private": true,
  "license": "MIT",
  "version": "0.1.7",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "lint": "eslint .",
    "web:dev": "pnpm --filter @codr/web dev",
    "web:build": "pnpm --filter @codr/web build",
    "postinstall": "electron-builder install-app-deps",
    "dist": "electron-vite build && electron-builder",
    "deploy": "tsx scripts/deploy.ts"
  },
  "dependencies": {
    "@codr-works/types": "^0.1.0",
    "@anthropic-ai/claude-agent-sdk": "^0.2.72",
    "@clerk/clerk-react": "^5.61.3",
    "cheerio": "^1.2.0",
    "diff": "^8.0.3",
    "fix-path": "^5.0.0",
    "lucide-react": "^0.577.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "robots-parser": "^3.0.1",
    "turndown": "^7.2.2",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/turndown": "^5.0.6",
    "@types/ws": "^8.18.1",
    "@vercel/blob": "^2.3.1",
    "@vitejs/plugin-react-swc": "^4.2.2",
    "dotenv": "^17.3.1",
    "electron": "^41.0.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1"
  }
}
